{
  "name": "sana-grade-8",
  "version": "1.0.0",
  "private": true,
  "description": "SANA — interactive grade 8 history, mathematics and physics in Russian and Kazakh.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-vendor.mjs && tailwindcss -i ./src/input.css -o ./dist/style.css --minify",
    "build:vendor": "node scripts/build-vendor.mjs",
    "dev": "tailwindcss -i ./src/input.css -o ./dist/style.css --watch",
    "watch": "tailwindcss -i ./src/input.css -o ./dist/style.css --watch",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  }
}
