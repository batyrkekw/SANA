# Copy to .env at the repository root. Never commit .env.
SANA_ENVIRONMENT=development
POSTGRES_PASSWORD=sana_local_only
SANA_DATABASE_URL=postgresql+psycopg://sana:sana_local_only@127.0.0.1:5432/sana
SANA_REDIS_URL=redis://127.0.0.1:6379/0
SANA_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://127.0.0.1:4173"]
# Preview server proxies to this loopback API; Docker serves frontend and API together.
SANA_API_ORIGIN=http://127.0.0.1:8000
SANA_SUPABASE_URL=
SANA_SUPABASE_PUBLISHABLE_KEY=
# jwks: asymmetric ES256/RS256; auth_server: /auth/v1/user for legacy HS256.
SANA_AUTH_MODE=jwks
SANA_JWT_AUDIENCE=authenticated
SANA_GOOGLE_OAUTH_ENABLED=false
# Optional local inference server. No paid API is required.
SANA_LLM_BASE_URL=http://127.0.0.1:11434/v1
SANA_DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
SANA_LLM_MODEL=
SANA_LLM_API_KEY=
SANA_LLM_TIMEOUT_SECONDS=180
SANA_LLM_CONTEXT_CHARACTERS=24000
SANA_LLM_MAX_TOKENS=4096
# For Qwen3/Ollama this disables thinking so the budget is used for the material.
# Leave empty for a server that does not support reasoning_effort.
SANA_LLM_REASONING_EFFORT=none
SANA_LLM_RESPONSE_FORMAT=json_schema
SANA_IMAGE_ENABLED=false
SANA_IMAGE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
SANA_IMAGE_VARIANT=fp16
SANA_IMAGE_DEVICE=auto
SANA_IMAGE_SIZE=512
SANA_IMAGE_STEPS=20
SANA_IMAGE_MAX_COUNT=4
# Absolute paths are recommended when overriding these; defaults are .data/ in the repo.
# SANA_MODEL_CACHE_DIR=/absolute/path/to/SANA/.data/models
# SANA_STORAGE_DIR=/absolute/path/to/SANA/.data/assets
# SANA_PLAN_CONFIG_PATH=/absolute/path/to/SANA/config/plans.json
SANA_MAX_ACTIVE_JOBS=2
SANA_JOB_TIMEOUT_SECONDS=900
SANA_QUEUE_TIMEOUT_SECONDS=3600
SANA_MAX_REQUEST_BYTES=65536
SANA_MAX_RESULT_BYTES=131072
# Internal SANA usage units, not money or LLM tokens; development settings only.
SANA_COSTS={"lesson":10,"quiz":6,"flashcards":6,"comic":12,"image":10}
